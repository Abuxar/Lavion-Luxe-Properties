# ---------- web (Vercel) ----------
# Vercel never holds Atlas credentials. It talks to the API over HTTPS.
API_BASE_URL=https://api.lavionluxe.com
NEXT_PUBLIC_SITE_URL=https://lavionluxe.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ---------- api (Hostinger KVM4) ----------
PORT=4000
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/lavion?retryWrites=true&w=majority
# Conservative on purpose: more sockets does not buy throughput against Flex.
MONGO_MAX_POOL=10
CORS_ORIGINS=https://lavionluxe.com
JWT_SECRET=
JWT_REFRESH_SECRET=
LOG_LEVEL=info
# UAE advertising permits expire; this worker pulls lapsed listings down.
PERMIT_CHECK_INTERVAL_MS=3600000
